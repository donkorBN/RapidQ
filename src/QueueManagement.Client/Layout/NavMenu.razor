@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/customer">RapidQ</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (IsCustomerPage)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer">
                    Customer Service
                </NavLink>
            </div>
        }

        @if (IsStaffPage)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="staff">
                    Service Desk
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string currentPath = string.Empty;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool IsCustomerPage => currentPath == "customer";
    private bool IsStaffPage => currentPath == "staff";

    protected override void OnInitialized()
    {
        currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += (_, _) =>
        {
            currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
            InvokeAsync(StateHasChanged);
        };
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
